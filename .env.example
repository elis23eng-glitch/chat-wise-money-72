# Configuração pública do Supabase usada pelo navegador.
# Copie este arquivo para `.env` e substitua os valores pelo ambiente local.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
VITE_SUPABASE_PROJECT_ID=seu-id-de-projeto

# Configuração do servidor. Nunca publique chaves secretas ou service role.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
SUPABASE_PROJECT_ID=seu-id-de-projeto

# Segredos configurados somente na plataforma de hospedagem.
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
